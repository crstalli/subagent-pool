{
  "name": "dsh-subagent-pool",
  "version": "1.0.0",
  "description": "Subagent Pool: caps concurrent subagents per model, routes to the right model, queues at capacity, and exposes a Settings card in the Web GUI.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./dsh/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "dsh/client.js",
    "cordis.patch.yml",
    "package.json",
    "subagent_pool_config.json"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {},
  "license": "MIT"
}
